# ============================================
# VI Agent Core — Environment Configuration
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=vi
POSTGRES_PASSWORD=vi_secret_change_me
POSTGRES_DB=vi_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=redis_dev_pass
REDIS_URL=redis://:redis_dev_pass@redis:6379/0

# --- JWT Auth (legacy, kept for migration period) ---
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Firebase Auth ---
FIREBASE_ENABLED=false
# Format: "package_name:project_id:service_account_path" (comma-separated for multi-project)
FIREBASE_PROJECTS=

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# --- Google Gemini (for vi-realtime) ---
GOOGLE_API_KEY=your-gemini-api-key

# --- Anthropic (for nanoclaw / Claude Opus 4.6) ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Gemini Live Model Config ---
GEMINI_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_REALTIME_VOICE=Aoede
GEMINI_REALTIME_TEMPERATURE=0.7

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api-server:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
INTERNAL_API_TOKEN=your-internal-api-token  # CHANGE THIS! Used for api-server <-> realtime auth

# --- Google Cloud Storage ---
GCS_BUCKET=your-gcs-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json  # optional if running on GCP

# --- NanoClaw (V4 Orchestrator) ---
NANOCLAW_USER_ID=dev-user

# --- OAuth Providers (optional, for V4 Token Center) ---
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# NOTION_OAUTH_CLIENT_ID=your-notion-oauth-client-id
# NOTION_OAUTH_CLIENT_SECRET=your-notion-oauth-client-secret
# SLACK_OAUTH_CLIENT_ID=your-slack-oauth-client-id
# SLACK_OAUTH_CLIENT_SECRET=your-slack-oauth-client-secret

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Frontend Firebase SDK ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PACKAGE_NAME=com.viapp.web
