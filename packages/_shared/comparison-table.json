{
  "$id": "comparison-table",
  "category": "think",
  "renderer": "html",
  "mutable": false,
  "streamable": true,
  "slots": {
    "title": { "type": "string", "streamable": true },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "image_url": { "type": "string" },
          "highlight": { "type": "boolean" }
        }
      }
    },
    "features": {
      "type": "array",
      "streamable": true,
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "values": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string" }
        }
      }
    },
    "verdict": { "type": "string", "streamable": true }
  }
}
