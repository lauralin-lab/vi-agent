{
  "$id": "place-card",
  "category": "present",
  "renderer": "react",
  "component": "PlaceCardModule",
  "mutable": false,
  "streamable": false,
  "description": "Restaurant/business/place card with hero image, rating, price level, address, hours, and map",
  "slots": {
    "name": { "type": "string", "required": true },
    "category": { "type": "string" },
    "rating": { "type": "number" },
    "price_level": { "type": "number" },
    "address": { "type": "string" },
    "phone": { "type": "string" },
    "hours": { "type": "string" },
    "image_url": { "type": "string" },
    "coordinates": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "url": { "type": "string" }
  }
}
