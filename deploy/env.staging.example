# VI Agent — Staging Environment Config
# Copy to /opt/vi-agent/.env on the staging VM

# --- Database (local container) ---
POSTGRES_PASSWORD=change-me-strong-password

# --- Redis (local container) ---
REDIS_PASSWORD=change-me-strong-password

# --- Auth ---
JWT_SECRET=change-me-random-64-hex
INTERNAL_API_TOKEN=change-me-random-32-hex

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- AI APIs ---
GOOGLE_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- App Config ---
API_BASE_URL=https://staging.internal.collov.ai
CORS_ORIGINS=https://staging.internal.collov.ai

# --- Docker Image Tag ---
IMAGE_TAG=latest
