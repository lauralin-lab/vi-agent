# VI Agent — Production Environment Config
# Copy to /opt/vi-agent/.env on the prod VM
# DB_HOST and REDIS_HOST come from Terraform outputs after apply

# --- Cloud SQL (managed) ---
DB_HOST=10.x.x.x
DB_USER=vi_agent
DB_PASSWORD=change-me-from-terraform-tfvars
DB_NAME=vi_agent

# --- Memorystore Redis (managed) ---
REDIS_HOST=10.x.x.x
REDIS_PORT=6379
REDIS_AUTH=change-me-from-terraform-output

# --- Auth ---
JWT_SECRET=change-me-random-64-hex
INTERNAL_API_TOKEN=change-me-random-32-hex

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- AI APIs ---
GOOGLE_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- App Config ---
API_BASE_URL=http://34.136.53.132:8000
CORS_ORIGINS=http://34.136.53.132,https://34.136.53.132

# --- Docker Image Tag ---
IMAGE_TAG=latest
